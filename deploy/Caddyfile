{
	servers {
		# The site is proxied by Cloudflare (https://www.cloudflare.com/ips/): take the visitor IP
		# from its headers only when the request really comes from Cloudflare.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$DOMAIN} {
	encode zstd gzip

	@hidden {
		path_regexp hidden (^|/)\..*
		not path /.well-known/acme-challenge/*
	}
	handle @hidden {
		respond 404
	}

	@backup_files path *.bak *.backup *.old *.save *.sql *.sql.gz
	handle @backup_files {
		respond 404
	}

	handle /sitemap.xml {
		rewrite * /api/v1/seo/sitemap.xml
		reverse_proxy backend:5000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /llms.txt {
		rewrite * /api/v1/seo/llms.txt
		reverse_proxy backend:5000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /api/v1/uploads/* {
		uri strip_prefix /api/v1/uploads
		root * /srv/uploads
		file_server
		header Cache-Control "public, max-age=604800"
	}

	handle /api/* {
		reverse_proxy backend:5000 {
			header_up X-Forwarded-For {client_ip}
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	log {
		output stdout
		format console
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
